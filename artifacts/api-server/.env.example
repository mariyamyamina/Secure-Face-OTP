# ── Express API Server ─────────────────────────────────────────────────────────
# Port the API server listens on
PORT=8080

# ── PostgreSQL Database ────────────────────────────────────────────────────────
# Full connection string to your local PostgreSQL database.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/auraauth

# ── Session ────────────────────────────────────────────────────────────────────
# A long random string used to sign admin session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_this_to_a_long_random_secret
