# ── Frontend Dev Server ────────────────────────────────────────────────────────
# Port the Vite dev server listens on
PORT=5173

# Base URL path for the app (use / for local development)
BASE_PATH=/

# ── API Proxy ──────────────────────────────────────────────────────────────────
# Port of the Express API server (Vite will proxy /api/* to this port)
# Must match the PORT set in artifacts/api-server/.env
API_PORT=8080

# ── EmailJS (OTP Emails) ───────────────────────────────────────────────────────
# Get these from https://www.emailjs.com/
# If NOT set, the app runs in dev mode and shows the OTP code on screen instead.
VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
